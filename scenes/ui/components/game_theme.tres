[gd_resource type="Theme" load_steps=3 format=3]

[ext_resource type="FontVariation" path="res://assets/fonts/noto_sans_jp_400.tres" id="1_font"]

[sub_resource type="StyleBoxFlat" id="focus_box"]
draw_center = false
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(1, 0.85, 0.2, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[resource]
default_font = ExtResource("1_font")
default_font_size = 24
Button/styles/focus = SubResource("focus_box")
CheckBox/styles/focus = SubResource("focus_box")
CheckButton/styles/focus = SubResource("focus_box")
ItemList/styles/focus = SubResource("focus_box")
LineEdit/styles/focus = SubResource("focus_box")
OptionButton/styles/focus = SubResource("focus_box")
Tree/styles/focus = SubResource("focus_box")
NoteLabel/base_type = &"Label"
NoteLabel/font_sizes/font_size = 20
